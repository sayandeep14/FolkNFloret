# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# credentials, and never give a server-only secret a NEXT_PUBLIC_ name — that
# prefix ships the value to the browser.
#
# Step-by-step for Supabase: docs/SUPABASE_SETUP.md

# The connection the app uses. On a managed host this is the POOLED URL.
# Supabase transaction pooler (IPv4-friendly, port 6543):
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres"

# The connection MIGRATIONS use. Must not be a transaction pooler — DDL needs
# one backend for the whole statement, and Prisma's migration lock needs an
# advisory lock that survives between statements.
# Supabase session pooler (IPv4-friendly, port 5432):
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# Running against a Postgres on this machine instead? One URL is enough:
# DATABASE_URL="postgresql://folksflorets:folksflorets@localhost:5432/folksflorets_dev?schema=public"
