# Copy to .env.local and fill in. .env.local is gitignored; this file is NOT —
# it is the committed template, so never put a real value in it.
#
# Step-by-step for Supabase: docs/SUPABASE_SETUP.md

# Optional. The public origin, used to make Open Graph image URLs absolute.
# On Vercel this is inferred from VERCEL_URL, so set it only once there is a
# custom domain.
# NEXT_PUBLIC_SITE_URL="https://folksandflorets.com"

# The Postgres connection. Starting out, this one URL is enough.
# Supabase: Connect → URI → Direct connection.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres"

# Optional, and only needed once DATABASE_URL points at a transaction pooler
# (port 6543) — which is at deployment. DDL cannot go through a transaction
# pooler, so migrations need a session pooler or a direct connection.
# DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# A Postgres on this machine instead:
# DATABASE_URL="postgresql://folksflorets:folksflorets@localhost:5432/folksflorets_dev?schema=public"

# --------------------------------------------------------------------------
# NOT USED, deliberately.
#
# Supabase also hands out NEXT_PUBLIC_SUPABASE_URL and a publishable key.
# Those reach PostgREST — Supabase's HTTP API — from the browser, guarded only
# by row-level security. This app does not use that path at all: it talks to
# Postgres over the wire protocol via Prisma, from the server, so that pricing,
# stock and payment logic cannot be bypassed by a client calling the API
# directly. Adding those keys back would open exactly that bypass.
#
# See docs/SUPABASE_SETUP.md §6.
# --------------------------------------------------------------------------

# --- Auth.js -------------------------------------------------------------
# Required. Signs session cookies and magic-link tokens; rotating it signs
# everyone out. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional. Each provider is offered only when its keys are present, so a
# deployment without them still sells — guests can check out.
#
# Magic link, via Resend. Verify the sending domain first or the mail lands in
# spam, which for a sign-in link means nobody can sign in.
AUTH_RESEND_KEY=""
EMAIL_FROM="hello@folknfloret.com"

# Google. Authorised redirect URI must be
#   https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
