# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# credentials, and never give a server-only secret a NEXT_PUBLIC_ name — that
# prefix ships the value to the browser.

# Postgres. Neon and Supabase both hand out two URLs: a pooled one for the app
# and a direct one for migrations. Use the direct URL when running
# `prisma migrate`, or migrations will fail against a connection pooler.
DATABASE_URL="postgresql://user:password@host:5432/folksflorets?sslmode=require"

# Local development against a Postgres on this machine looks like:
# DATABASE_URL="postgresql://folksflorets:folksflorets@localhost:5432/folksflorets_dev?schema=public"
